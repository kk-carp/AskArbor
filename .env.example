DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fde

CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

EMBED_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=8

RETRIEVE_TOP_K=5
RETRIEVE_MIN_SCORE=0.3

UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=52428800

# local=本机/上课（会写入演示账号）；prod=正式环境（禁止默认密钥和演示密码，且不写入演示账号；带登录 Cookie 的写请求会校验 Origin/Referer）
APP_ENV=local

SECRET_KEY=change-me-for-local-dev
DEMO_PASSWORD=demo1234

# 会话与已回复工单保留天数；启动时清理一次，也可 python -m backend.scripts.purge_expired
DATA_RETENTION_DAYS=90

# 学习路径课外搜索（逗号分隔；可空。通用收费课/训练营已内置拦截）
TAVILY_API_KEY=
LEARNING_PATH_SEARCH_TIMEOUT_SECONDS=15
LEARNING_PATH_RECENT_QUESTIONS=20
LEARNING_PATH_BLOCK_KEYWORDS=
LEARNING_PATH_BLOCK_HOSTS=

# 图片识文：Qwen-VL（可用 DashScope API Key）+ 可选 PaddleOCR 兜底
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus
VISION_TIMEOUT_SECONDS=60
OCR_ENABLED=true

# 下载 BGE-M3 受阻时启用
# HF_ENDPOINT=https://hf-mirror.com
